# The one account that can sign in. There is no registration.
CKA_USER=change-me
CKA_PASSWORD=change-me-to-a-long-passphrase

# Host port the app listens on. Optional.
# CKA_PORT=8080

# Address the port is bound to. The default, 127.0.0.1, only lets a reverse
# proxy on this machine in. Use 0.0.0.0 to reach it from your LAN directly —
# that is plain HTTP, so the password travels unencrypted on that network.
# CKA_BIND=127.0.0.1
